@page "/pipelines"
@rendermode InteractiveServer
@implements IDisposable
@inject PipelineService PipelineService
@inject RepositoryCatalogService RepositoryCatalogService
@inject GitLabRepositoryService GitLabRepositoryService
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Pipelines</PageTitle>

<div class="pipeline-shell">
    <h1>Metadata-driven pipeline generator</h1>

    <div class="sub-grid">
        <section class="pipeline-form">
            <h2>Generate workflow preview</h2>
            <EditForm Model="request" OnValidSubmit="CreatePipeline">
                <div class="form-row">
                    <div class="form-field">
                        <label for="repo">Repository</label>
                        <InputSelect id="repo" @bind-Value="request.RepositoryId" @bind-Value:after="UpdateGeneratedPreview">
                            @foreach (var repo in repositories)
                            {
                                <option value="@repo.Id">@repo.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label for="environment">Target environment</label>
                        <InputSelect id="environment" @bind-Value="request.Environment" @bind-Value:after="UpdateGeneratedPreview">
                            <option value="DEV">DEV</option>
                            <option value="UAT">UAT</option>
                            <option value="PROD">PROD</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="branch">Source branch</label>
                        <InputText id="branch" @bind-Value="request.SourceBranch" />
                    </div>
                    <div class="form-field">
                        <label for="workflow-path">Workflow path (optional)</label>
                        <InputText id="workflow-path" @bind-Value="request.WorkflowPath" placeholder=".gitlab-ci.yml" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label for="ticket">Change ticket</label>
                        <InputText id="ticket" @bind-Value="request.ChangeTicket" />
                    </div>
                    <div class="form-field">
                        <label for="version">Artifact version</label>
                        <InputText id="version" @bind-Value="request.ArtifactVersion" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label for="template">Template</label>
                        <InputSelect id="template" @bind-Value="request.SelectedTemplate" @bind-Value:after="UpdateGeneratedPreview">
                            @foreach (var template in templates)
                            {
                                <option value="@template.Id">@template.Name</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" disabled="@(!repositories.Any())">Generate workflow</button>
            </EditForm>
        </section>

        <aside class="activity-list">
            <div class="section-header">
                <h2>Production controls</h2>
            </div>
            <ul>
                <li class="warning">
                    <span class="activity-title">Policy enforcement</span>
                    <span class="activity-detail">Production requires UAT validation, approval, and a valid ticket.</span>
                    <span class="activity-time">Immutable artifact promotion only</span>
                </li>
            </ul>
        </aside>
    </div>

    <div class="pipeline-table">
        <div class="pipeline-card">
            <h3>Workflow YAML editor</h3>
            <p class="small-text">Edit YAML directly, then run diagnostics before using it.</p>
            <textarea class="yaml-editor" @bind="editableYaml" @bind:event="oninput"></textarea>
            <div class="repo-card-actions" style="margin-top: 0.75rem; justify-content: flex-start;">
                <button class="btn btn-outline" type="button" @onclick="RunYamlDiagnostics">Test YAML</button>
                <button class="btn btn-outline" type="button" @onclick="AssistYamlWithGitLabAsync" disabled="@lintInProgress">
                    @if (lintInProgress)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 0.5rem; vertical-align: middle;"></span>
                    }
                    <span>Assist YAML</span>
                </button>
                <button class="btn btn-outline" type="button" @onclick="CopyEditorYaml">Copy YAML</button>
                <button class="btn btn-outline" type="button" @onclick="PasteYamlFromClipboard">Paste YAML</button>
                <button class="btn btn-secondary" type="button" @onclick="ResetYamlEditor">Reset to generated</button>
                <button class="btn btn-primary" type="button" @onclick="DeployYamlToRepository" disabled="@(!CanDeployYaml)">
                    @if (deployInProgress)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 0.5rem; vertical-align: middle;"></span>
                    }
                    <span>Deploy YAML</span>
                </button>
            </div>

            @if (showAgentModal)
            {
                <div @ref="agentModalRef" tabindex="0" @onkeydown="AgentModalKeyDown" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center; z-index:1050;">
                    <div style="width:90%; max-width:1000px; background:white; border-radius:8px; box-shadow:0 6px 24px rgba(0,0,0,.3); overflow:hidden;">
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:0.5rem 0.75rem; border-bottom:1px solid #e5e7eb;">
                            <strong>GitLab Duo Agent</strong>
                            <div>
                                <button class="btn btn-sm btn-outline" @onclick="CloseAgentModal">Close</button>
                            </div>
                        </div>
                        <div style="padding:0.75rem;">
                            <AgentChat ProjectId="@agentProjectId" InitialPrompt="@agentPrompt" AutoStart="true" />
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(deployStatusMessage))
            {
                <div class="small-text" style="margin-top: 0.55rem; padding: 0.6rem 0.8rem; border-radius: 10px; border: 1px solid @(deployStatusIsError ? "rgba(248,113,113,0.45)" : "rgba(74,222,128,0.45)"); background: @(deployStatusIsError ? "rgba(127,29,29,0.35)" : "rgba(20,83,45,0.35)"); color: @(deployStatusIsError ? "#fecaca" : "#dcfce7");">
                    @deployStatusMessage
                </div>
            }

            @if (deployLogs.Count > 0)
            {
                <div class="analysis-console" role="status" aria-live="polite" style="margin-top: 0.65rem;">
                    <div class="analysis-console-header">Deployment console</div>
                    <pre>@string.Join("\n", deployLogs)</pre>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(deployedYamlPreview))
            {
                <div class="yaml-diagnostics">
                    <h4>Deployed workflow preview</h4>
                    <div class="small-text">@deployedRepositoryName · @deployedWorkflowPath · @deployedBranch</div>
                    <div class="repo-card-actions" style="margin-top: 0.5rem; justify-content: flex-start;">
                        <button class="btn btn-outline" type="button" @onclick="CopyViewedYaml">Copy YAML</button>
                        <button class="btn btn-secondary" type="button" @onclick="LoadViewedYamlIntoEditor">Use in editor</button>
                    </div>
                    <pre class="small-text" style="margin-top:0.5rem; white-space: pre-wrap; background: rgba(2,6,23,0.65); border: 1px solid rgba(148,163,184,0.24); border-radius: 10px; padding: 0.65rem;">@deployedYamlPreview</pre>
                </div>
            }

            @if (yamlDiagnostics.Count > 0)
            {
                <div class="yaml-diagnostics">
                    <h4>Diagnostics</h4>
                    @foreach (var issue in yamlDiagnostics)
                    {
                        <div class="diag-item @GetDiagnosticClass(issue.Severity)">
                            <strong>@issue.Severity</strong> · @issue.Message
                            <div class="small-text">@issue.Detail</div>
                            @if (!string.IsNullOrWhiteSpace(issue.Recommendation))
                            {
                                <div class="small-text" style="margin-top:0.35rem;"><strong>Recommendation:</strong> @issue.Recommendation</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(issue.SuggestedTemplateId))
                            {
                                <button class="btn btn-outline" style="margin-top:0.45rem;" type="button" @onclick="() => ApplySuggestedTemplate(issue.SuggestedTemplateId)">
                                    Apply template @issue.SuggestedTemplateId
                                </button>
                            }
                            @if (!string.IsNullOrWhiteSpace(issue.SuggestedYamlSnippet))
                            {
                                <pre class="small-text" style="margin-top:0.5rem; white-space: pre-wrap; background: rgba(2,6,23,0.65); border: 1px solid rgba(148,163,184,0.24); border-radius: 10px; padding: 0.65rem;">@issue.SuggestedYamlSnippet</pre>
                                <button class="btn btn-outline" style="margin-top:0.45rem;" type="button" @onclick="() => ApplyYamlSnippet(issue.SuggestedYamlSnippet)">
                                    Apply YAML fix
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (lintResult is not null)
            {
                <div class="yaml-diagnostics">
                    <h4>GitLab CI assistant</h4>
                    <div class="small-text"><strong>Status:</strong> @(lintResult.Valid ? "Valid" : "Needs attention")</div>
                    <div class="small-text">@lintResult.Message</div>

                    @if (lintResult.Errors.Count > 0)
                    {
                        <div class="small-text" style="margin-top:0.45rem;"><strong>Lint errors</strong></div>
                        <ul>
                            @foreach (var err in lintResult.Errors)
                            {
                                <li class="small-text">@err</li>
                            }
                        </ul>
                    }

                    @if (lintResult.Warnings.Count > 0)
                    {
                        <div class="small-text" style="margin-top:0.45rem;"><strong>Lint warnings</strong></div>
                        <ul>
                            @foreach (var warning in lintResult.Warnings)
                            {
                                <li class="small-text">@warning</li>
                            }
                        </ul>
                    }

                    @if (assistantSuggestions.Count > 0)
                    {
                        <div class="small-text" style="margin-top:0.45rem;"><strong>Suggested fixes</strong></div>
                        <ul>
                            @foreach (var suggestion in assistantSuggestions)
                            {
                                <li class="small-text">@suggestion</li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="yaml-diagnostics">
                <h4>Assist YAML chat</h4>
                <div style="display:grid; gap:0.45rem; max-height:220px; overflow:auto; padding:0.55rem; border:1px solid rgba(148,163,184,0.24); border-radius:10px; background:rgba(2,6,23,0.55);">
                    @foreach (var message in assistantMessages)
                    {
                        <div style="padding:0.45rem 0.55rem; border-radius:8px; background:@(message.Role == "user" ? "rgba(59,130,246,0.22)" : "rgba(15,23,42,0.9)"); border:1px solid rgba(148,163,184,0.2);">
                            <div class="small-text" style="font-weight:600;">@(message.Role == "user" ? "You" : "Assistant")</div>
                            <div class="small-text">@message.Content</div>
                        </div>
                    }
                </div>

                <div style="display:flex; gap:0.5rem; margin-top:0.55rem; align-items:center;">
                    <input class="form-control" @bind="assistantPrompt" @bind:event="oninput" placeholder="Ask for YAML guidance (e.g., add test stage and fix lint errors)" />
                    <button class="btn btn-outline" type="button" @onclick="AskAssistantAsync" disabled="@assistantBusy">
                        @if (assistantBusy)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right: 0.5rem; vertical-align: middle;"></span>
                        }
                        <span>Send</span>
                    </button>
                </div>

                @if (suggestionCards.Count > 0)
                {
                    <div style="display:grid; gap:0.55rem; margin-top:0.7rem;">
                        @foreach (var card in suggestionCards)
                        {
                            <div style="border:1px solid rgba(148,163,184,0.24); border-radius:10px; padding:0.6rem; background:rgba(15,23,42,0.6);">
                                <div style="display:flex; justify-content:space-between; gap:0.5rem; align-items:center;">
                                    <strong>@card.Title</strong>
                                    <span class="small-text">@card.Category</span>
                                </div>
                                <div class="small-text" style="margin-top:0.35rem;">@card.Description</div>
                                <div class="repo-card-actions" style="margin-top:0.55rem; justify-content:flex-start;">
                                    <button class="btn btn-outline" type="button" @onclick="() => PreviewSuggestionDiff(card.Id)">Preview diff</button>
                                    <button class="btn btn-secondary" type="button" @onclick="() => ApplySuggestionCard(card.Id)">Apply</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(suggestionDiffPreview))
                {
                    <div style="margin-top:0.7rem;">
                        <div class="small-text" style="font-weight:600; margin-bottom:0.35rem;">Proposed diff</div>
                        <pre class="small-text" style="white-space: pre-wrap; background: rgba(2,6,23,0.65); border: 1px solid rgba(148,163,184,0.24); border-radius: 10px; padding: 0.65rem;">@suggestionDiffPreview</pre>
                    </div>
                }
            </div>
        </div>

        @foreach (var pipeline in pipelines)
        {
            <article class="pipeline-card">
                <div class="pipeline-header">
                    <div class="pipeline-name-group">
                        <span class="pipeline-dot @(GetStatusClass(pipeline.Status))"></span>
                        <div>
                            <h3>@pipeline.Name</h3>
                            <div class="small-text">@pipeline.Project · @pipeline.Branch</div>
                        </div>
                    </div>
                    <span class="pipeline-status @(GetStatusClass(pipeline.Status))">@pipeline.Status</span>
                </div>

                <div class="inline-status">
                    <span class="small-text">Trigger: @pipeline.Trigger</span>
                    <span class="small-text">·</span>
                    <span class="small-text">Last run: @pipeline.LastRun.ToLocalTime().ToString("g")</span>
                    @if (!string.IsNullOrWhiteSpace(pipeline.ExternalPipelineUrl))
                    {
                        <span class="small-text">·</span>
                        <a class="small-text" href="@pipeline.ExternalPipelineUrl" target="_blank" rel="noreferrer">Open GitLab run</a>
                    }
                </div>

                <div class="stage-list">
                    @foreach (var stage in pipeline.Stages)
                    {
                        <div class="stage-row">
                            <span>@stage.Name</span>
                            <div class="progress-bar"><span style="width:@(stage.Progress)%"></span></div>
                            <strong>@stage.Progress%</strong>
                        </div>
                    }
                </div>

                @if (pipeline.ConsoleOutput.Count > 0)
                {
                    <div class="analysis-console" role="status" aria-live="polite">
                        <div class="analysis-console-header">Run console</div>
                        <pre>@string.Join("\n", pipeline.ConsoleOutput)</pre>
                    </div>
                }

                <div class="pipeline-actions">
                    <span class="small-text">Success rate: @pipeline.SuccessRate%</span>
                    <button class="btn btn-outline" @onclick="() => ViewPipelineYaml(pipeline)">View YAML</button>
                    @if (pipeline.Status == PipelineStatus.Running)
                    {
                        <button class="btn btn-secondary" @onclick="() => CancelPipeline(pipeline.Id)">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-outline" @onclick="() => StartPipeline(pipeline.Id)">Run</button>
                    }
                </div>
            </article>
        }
    </div>
</div>

@code {
    private List<PipelineDefinition> pipelines = [];
    private PipelineSummary summary = new();
    private ReleaseWorkflowRequest request = new();
    private IReadOnlyList<RepositoryDefinition> repositories = [];
    private IReadOnlyList<PipelineTemplateDefinition> templates = [];
    private string generatedYaml = string.Empty;
    private string editableYaml = string.Empty;
    private List<WorkflowDiagnosticIssue> yamlDiagnostics = [];
    private readonly List<string> deployLogs = [];
    private bool diagnosticsExecuted;
    private bool deployInProgress;
    private string deployStatusMessage = string.Empty;
    private bool deployStatusIsError;
    private string deployedYamlPreview = string.Empty;
    private string deployedWorkflowPath = string.Empty;
    private string deployedRepositoryName = string.Empty;
    private string deployedBranch = string.Empty;
    private bool lintInProgress;
    private GitLabCiLintResult? lintResult;
    private List<string> assistantSuggestions = [];
    private readonly List<YamlAssistantMessage> assistantMessages = [];
    private readonly List<YamlSuggestionCard> suggestionCards = [];
    private string assistantPrompt = string.Empty;
    private string suggestionDiffPreview = string.Empty;
    private bool assistantBusy;
    private bool showAgentModal = false;
    private string agentPrompt = string.Empty;
    private string? agentProjectId;
    private ElementReference agentModalRef;

    protected override async Task OnInitializedAsync()
    {
        PipelineService.Changed += OnPipelineStateChanged;
        PipelineService.ReloadFromDatabase();
        repositories = RepositoryCatalogService.GetSavedRepositorySnapshot();
        templates = RepositoryCatalogService.GetTemplateCatalog();
        request.RepositoryId = repositories.FirstOrDefault()?.Id ?? string.Empty;
        request.SelectedTemplate = templates.FirstOrDefault()?.Id ?? string.Empty;
        Refresh();
        await UpdateGeneratedPreview();
        SeedAssistantWelcome();
    }

    private void Refresh()
    {
        pipelines = PipelineService.GetPipelines().ToList();
        summary = PipelineService.GetSummary();
    }

    private async Task StartPipeline(int pipelineId)
    {
        await PipelineService.StartPipelineRunAsync(pipelineId);
        Refresh();
    }

    private async Task CancelPipeline(int pipelineId)
    {
        await PipelineService.CancelPipelineRunAsync(pipelineId);
        Refresh();
    }

    private void ViewPipelineYaml(PipelineDefinition pipeline)
    {
        var storedYaml = RepositoryCatalogService.GetLatestWorkflowYamlForPipeline(pipeline.RepositoryId, pipeline.Name, pipeline.Project);
        if (storedYaml is null)
        {
            deployStatusIsError = true;
            deployStatusMessage = $"No deployed YAML was found for {pipeline.Name}. Deploy the workflow first.";
            return;
        }

        editableYaml = storedYaml.Value.Yaml;
        generatedYaml = storedYaml.Value.Yaml;
        deployedYamlPreview = storedYaml.Value.Yaml;
        deployedWorkflowPath = storedYaml.Value.WorkflowPath;
        deployedRepositoryName = storedYaml.Value.RepositoryName;
        deployedBranch = storedYaml.Value.Branch;
        deployStatusIsError = false;
        deployStatusMessage = $"Loaded deployed YAML for {storedYaml.Value.RepositoryName} from {storedYaml.Value.DeployedUtc.ToLocalTime():g}.";
        yamlDiagnostics.Clear();
        diagnosticsExecuted = false;

        if (!string.IsNullOrWhiteSpace(pipeline.RepositoryId))
        {
            request.RepositoryId = pipeline.RepositoryId;
        }
    }

    private void LoadViewedYamlIntoEditor()
    {
        if (string.IsNullOrWhiteSpace(deployedYamlPreview))
        {
            return;
        }

        editableYaml = deployedYamlPreview;
        generatedYaml = deployedYamlPreview;
        deployStatusIsError = false;
        deployStatusMessage = $"Loaded viewed YAML into the editor for {deployedRepositoryName}.";
    }

    private Task CopyEditorYaml()
    {
        return CopyYamlToClipboard(editableYaml, "Editor YAML");
    }

    private Task CopyViewedYaml()
    {
        return CopyYamlToClipboard(deployedYamlPreview, "Viewed YAML");
    }

    private async Task PasteYamlFromClipboard()
    {
        var yaml = await JS.InvokeAsync<string>("navigator.clipboard.readText");
        if (string.IsNullOrWhiteSpace(yaml))
        {
            deployStatusIsError = true;
            deployStatusMessage = "Clipboard is empty.";
            return;
        }

        editableYaml = yaml;
        deployStatusIsError = false;
        deployStatusMessage = "Clipboard YAML pasted into the editor.";
        yamlDiagnostics.Clear();
        diagnosticsExecuted = false;
        ClearAssistantOutput();
    }

    private async Task CopyYamlToClipboard(string yaml, string sourceLabel)
    {
        if (string.IsNullOrWhiteSpace(yaml))
        {
            deployStatusIsError = true;
            deployStatusMessage = $"{sourceLabel} is empty.";
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", yaml);
        deployStatusIsError = false;
        deployStatusMessage = $"{sourceLabel} copied to clipboard.";
    }

    private void CreatePipeline()
    {
        if (string.IsNullOrWhiteSpace(request.RepositoryId))
        {
            generatedYaml = "No repository selected. Add or analyze a repository to generate workflow YAML.";
            editableYaml = generatedYaml;
            diagnosticsExecuted = false;
            deployStatusMessage = string.Empty;
            deployStatusIsError = false;
            deployLogs.Clear();
            deployedYamlPreview = string.Empty;
            deployedWorkflowPath = string.Empty;
            deployedRepositoryName = string.Empty;
            deployedBranch = string.Empty;
            return;
        }

        var repo = RepositoryCatalogService.AnalyzeRepository(request.RepositoryId);
        var storedYaml = RepositoryCatalogService.GetLatestWorkflowYamlForPipeline(repo.Id, repo.Name, repo.Owner);

        if (storedYaml is not null)
        {
            generatedYaml = storedYaml.Value.Yaml;
            editableYaml = storedYaml.Value.Yaml;
            deployedYamlPreview = storedYaml.Value.Yaml;
            deployedWorkflowPath = storedYaml.Value.WorkflowPath;
            deployedRepositoryName = storedYaml.Value.RepositoryName;
            deployedBranch = storedYaml.Value.Branch;
            deployStatusIsError = false;
            deployStatusMessage = $"Loaded existing YAML for {storedYaml.Value.RepositoryName} from {storedYaml.Value.DeployedUtc.ToLocalTime():g}.";
        }
        else
        {
            generatedYaml = RepositoryCatalogService.GeneratePreview(repo, request.SelectedTemplate, request.Environment);
            editableYaml = generatedYaml;
            deployStatusMessage = string.Empty;
            deployStatusIsError = false;
            deployedYamlPreview = string.Empty;
            deployedWorkflowPath = string.Empty;
            deployedRepositoryName = string.Empty;
            deployedBranch = string.Empty;
        }

        diagnosticsExecuted = false;
        deployLogs.Clear();
        PipelineService.AddPipeline(repo.Id, repo.Name, repo.Owner, repo.DefaultBranch, request.Environment);
        Refresh();
    }

    private bool CanDeployYaml =>
        !deployInProgress
        && diagnosticsExecuted
        && !string.IsNullOrWhiteSpace(request.RepositoryId)
        && yamlDiagnostics.All(i => i.Severity != WorkflowDiagnosticSeverity.Error);

    private async Task UpdateGeneratedPreview()
    {
        if (string.IsNullOrWhiteSpace(request.RepositoryId))
        {
            generatedYaml = "No repository selected. Add or analyze a repository to generate workflow YAML.";
            editableYaml = generatedYaml;
            yamlDiagnostics.Clear();
            diagnosticsExecuted = false;
            deployStatusMessage = string.Empty;
            deployStatusIsError = false;
            deployLogs.Clear();
            deployedYamlPreview = string.Empty;
            deployedWorkflowPath = string.Empty;
            deployedRepositoryName = string.Empty;
            deployedBranch = string.Empty;
            return;
        }

        var repo = repositories.FirstOrDefault(r => r.Id == request.RepositoryId)
            ?? RepositoryCatalogService.AnalyzeRepository(request.RepositoryId);

        var loadedFromMainBranch = false;
        var runContext = RepositoryCatalogService.GetRunContext(repo.Id);
        if (runContext is not null && repo.Provider == RepositoryProvider.GitLab)
        {
            var workflowFile = await GitLabRepositoryService.TryGetWorkflowFileAsync(
                runContext.ProjectReference,
                "main",
                ".gitlab-ci.yml",
                runContext.AccessToken,
                CancellationToken.None);

            if (workflowFile.Found && !string.IsNullOrWhiteSpace(workflowFile.Yaml))
            {
                generatedYaml = workflowFile.Yaml;
                editableYaml = workflowFile.Yaml;
                deployedYamlPreview = workflowFile.Yaml;
                deployedWorkflowPath = workflowFile.WorkflowPath;
                deployedRepositoryName = repo.Name;
                deployedBranch = workflowFile.Branch;
                deployStatusIsError = false;
                deployStatusMessage = $"Loaded .gitlab-ci.yml from main branch for {repo.Name}.";
                loadedFromMainBranch = true;
            }
        }

        if (!loadedFromMainBranch)
        {
            var storedYaml = RepositoryCatalogService.GetLatestWorkflowYamlForPipeline(repo.Id, repo.Name, repo.Owner);
            if (storedYaml is not null)
            {
                generatedYaml = storedYaml.Value.Yaml;
                editableYaml = storedYaml.Value.Yaml;
                deployedYamlPreview = storedYaml.Value.Yaml;
                deployedWorkflowPath = storedYaml.Value.WorkflowPath;
                deployedRepositoryName = storedYaml.Value.RepositoryName;
                deployedBranch = storedYaml.Value.Branch;
                deployStatusIsError = false;
                deployStatusMessage = $"Loaded existing YAML for {storedYaml.Value.RepositoryName} from {storedYaml.Value.DeployedUtc.ToLocalTime():g}.";
            }
            else
            {
                generatedYaml = RepositoryCatalogService.GeneratePreview(repo, request.SelectedTemplate, request.Environment);
                editableYaml = generatedYaml;
                deployStatusMessage = string.Empty;
                deployStatusIsError = false;
                deployedYamlPreview = string.Empty;
                deployedWorkflowPath = string.Empty;
                deployedRepositoryName = string.Empty;
                deployedBranch = string.Empty;
            }
        }

        yamlDiagnostics.Clear();
        diagnosticsExecuted = false;
        deployLogs.Clear();
        ClearAssistantOutput();
    }

    private void ResetYamlEditor()
    {
        editableYaml = generatedYaml;
        yamlDiagnostics.Clear();
        diagnosticsExecuted = false;
        deployStatusMessage = string.Empty;
        deployStatusIsError = false;
        deployLogs.Clear();
        deployedYamlPreview = string.Empty;
        deployedWorkflowPath = string.Empty;
        deployedRepositoryName = string.Empty;
        deployedBranch = string.Empty;
        ClearAssistantOutput();
    }

    private void RunYamlDiagnostics()
    {
        if (string.IsNullOrWhiteSpace(request.RepositoryId))
        {
            yamlDiagnostics =
            [
                new WorkflowDiagnosticIssue
                {
                    Severity = WorkflowDiagnosticSeverity.Error,
                    Message = "Repository selection is required.",
                    Detail = "Select a repository before running workflow diagnostics."
                }
            ];
            return;
        }

        var repo = repositories.FirstOrDefault(r => r.Id == request.RepositoryId)
            ?? RepositoryCatalogService.AnalyzeRepository(request.RepositoryId);

        yamlDiagnostics = RepositoryCatalogService
            .DiagnoseWorkflowYaml(editableYaml, repo.Provider, request.SelectedTemplate)
            .ToList();
        diagnosticsExecuted = true;
        deployStatusMessage = string.Empty;
        deployStatusIsError = false;
    }

    private async Task AssistYamlWithGitLabAsync()
    {
        RunYamlDiagnostics();
        ClearAssistantOutput();

        if (string.IsNullOrWhiteSpace(request.RepositoryId))
        {
            deployStatusIsError = true;
            deployStatusMessage = "Select a repository before requesting YAML assistance.";
            return;
        }

        var runContext = RepositoryCatalogService.GetRunContext(request.RepositoryId);
        if (runContext is null)
        {
            deployStatusIsError = true;
            deployStatusMessage = "Repository runtime context is unavailable. Reconnect the source and verify token access.";
            AddAssistantMessage("assistant", deployStatusMessage);
            return;
        }

        if (runContext.Repository.Provider != RepositoryProvider.GitLab)
        {
            deployStatusIsError = true;
            deployStatusMessage = "GitLab CI assistant is currently available only for GitLab repositories.";
            AddAssistantMessage("assistant", deployStatusMessage);
            return;
        }

        lintInProgress = true;
        try
        {
            var branch = string.IsNullOrWhiteSpace(request.SourceBranch)
                ? runContext.Repository.DefaultBranch
                : request.SourceBranch;

            lintResult = await GitLabRepositoryService.ValidateCiYamlAsync(
                runContext.ProjectReference,
                branch,
                editableYaml,
                runContext.AccessToken,
                CancellationToken.None);

            assistantSuggestions = BuildAssistantSuggestions(lintResult, yamlDiagnostics);
            suggestionCards.Clear();
            suggestionCards.AddRange(BuildSuggestionCards(editableYaml, lintResult, yamlDiagnostics));
            deployStatusIsError = !lintResult.Success || !lintResult.Valid;
            deployStatusMessage = lintResult.Message;
            AddAssistantMessage("assistant", BuildAssistantSummary(lintResult, suggestionCards.Count));

            // Open inline Agent chat modal and auto-start with current YAML
            agentPrompt = editableYaml;
            agentProjectId = runContext.ProjectReference;
            showAgentModal = true;
            // give the UI a render pass, then focus the modal so keyboard (ESC) works immediately
            await InvokeAsync(StateHasChanged);
            try
            {
                await agentModalRef.FocusAsync();
            }
            catch
            {
                // ignore focus failures in non-browser test environments
            }
        }
        finally
        {
            lintInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseAgentModal()
    {
        showAgentModal = false;
        agentPrompt = string.Empty;
        agentProjectId = null;
    }

    private void AgentModalKeyDown(KeyboardEventArgs e)
    {
        if (e is not null && e.Key == "Escape")
        {
            CloseAgentModal();
        }
    }

    private async Task AskAssistantAsync()
    {
        if (assistantBusy)
        {
            return;
        }

        var prompt = assistantPrompt.Trim();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        assistantBusy = true;
        try
        {
            AddAssistantMessage("user", prompt);
            assistantPrompt = string.Empty;

            if (lintResult is null)
            {
                await AssistYamlWithGitLabAsync();
            }

            var cards = BuildSuggestionCards(editableYaml, lintResult, yamlDiagnostics, prompt);
            suggestionCards.Clear();
            suggestionCards.AddRange(cards);
            AddAssistantMessage("assistant", cards.Count == 0
                ? "I analyzed the YAML and found no safe automatic patch. Run Assist YAML again after edits."
                : $"I prepared {cards.Count} suggestion card(s). Preview diff or apply directly.");
        }
        finally
        {
            assistantBusy = false;
        }
    }

    private static List<string> BuildAssistantSuggestions(GitLabCiLintResult lint, IReadOnlyList<WorkflowDiagnosticIssue> diagnostics)
    {
        var suggestions = new List<string>();

        suggestions.AddRange(lint.Errors.Select(error => $"Fix GitLab lint error: {error}"));
        suggestions.AddRange(lint.Warnings.Select(warning => $"Review GitLab lint warning: {warning}"));

        foreach (var issue in diagnostics.Where(issue => issue.Severity != WorkflowDiagnosticSeverity.Info))
        {
            var message = string.IsNullOrWhiteSpace(issue.Recommendation)
                ? issue.Message
                : $"{issue.Message} — {issue.Recommendation}";
            suggestions.Add($"Address diagnostic: {message}");
        }

        return suggestions
            .Where(text => !string.IsNullOrWhiteSpace(text))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private List<YamlSuggestionCard> BuildSuggestionCards(string currentYaml, GitLabCiLintResult? lint, IReadOnlyList<WorkflowDiagnosticIssue> diagnostics, string? prompt = null)
    {
        var cards = new List<YamlSuggestionCard>();
        var normalized = currentYaml.Replace("\r\n", "\n", StringComparison.Ordinal);

        if (string.IsNullOrWhiteSpace(normalized))
        {
            cards.Add(new YamlSuggestionCard(
                Id: "seed-default",
                Category: "Template",
                Title: "Seed minimal GitLab pipeline",
                Description: "Adds minimal stages and a default test job to bootstrap the pipeline.",
                ProposedYaml: "stages:\n  - build\n  - test\n\ndefault-build:\n  stage: build\n  script:\n    - echo \"build step\"\n\ndefault-test:\n  stage: test\n  script:\n    - echo \"test step\""));
        }

        if (!normalized.Contains("stages:", StringComparison.OrdinalIgnoreCase))
        {
            cards.Add(new YamlSuggestionCard(
                Id: "add-stages",
                Category: "Structure",
                Title: "Add stages section",
                Description: "Defines build/test/deploy stages expected by common GitLab workflows.",
                ProposedYaml: $"stages:\n  - build\n  - test\n  - deploy\n\n{normalized.Trim()}"));
        }

        if (normalized.Contains("stage: test", StringComparison.OrdinalIgnoreCase)
            && !normalized.Contains("- test", StringComparison.OrdinalIgnoreCase)
            && normalized.Contains("stages:", StringComparison.OrdinalIgnoreCase))
        {
            cards.Add(new YamlSuggestionCard(
                Id: "insert-test-stage",
                Category: "Stage",
                Title: "Declare test stage",
                Description: "Adds '- test' to the stages list to match test jobs.",
                ProposedYaml: EnsureGitLabTestStage(normalized)));
        }

        if (lint is not null && lint.Errors.Any(error => error.Contains("script", StringComparison.OrdinalIgnoreCase)) && !normalized.Contains("script:", StringComparison.OrdinalIgnoreCase))
        {
            cards.Add(new YamlSuggestionCard(
                Id: "add-script",
                Category: "Job",
                Title: "Add script block",
                Description: "Adds a default script block to satisfy GitLab job requirements.",
                ProposedYaml: $"{normalized.Trim()}\n\ndefault-job:\n  stage: test\n  script:\n    - echo \"update script commands\""));
        }

        foreach (var diagnostic in diagnostics.Where(d => !string.IsNullOrWhiteSpace(d.SuggestedYamlSnippet)).Take(2))
        {
            var snippet = diagnostic.SuggestedYamlSnippet.Trim();
            if (normalized.Contains(snippet, StringComparison.Ordinal))
            {
                continue;
            }

            cards.Add(new YamlSuggestionCard(
                Id: $"diag-{cards.Count + 1}",
                Category: "Diagnostic",
                Title: "Apply diagnostic snippet",
                Description: diagnostic.Message,
                ProposedYaml: string.IsNullOrWhiteSpace(normalized) ? snippet : $"{normalized.Trim()}\n\n{snippet}"));
        }

        if (!string.IsNullOrWhiteSpace(prompt) && prompt.Contains("test", StringComparison.OrdinalIgnoreCase) && !normalized.Contains("stage: test", StringComparison.OrdinalIgnoreCase))
        {
            cards.Add(new YamlSuggestionCard(
                Id: "prompt-test-job",
                Category: "Prompt",
                Title: "Add test job",
                Description: "Adds a basic test job based on your prompt.",
                ProposedYaml: $"{normalized.Trim()}\n\nunit-test:\n  stage: test\n  script:\n    - dotnet test"));
        }

        return cards
            .Where(card => !string.Equals(card.ProposedYaml.Trim(), normalized.Trim(), StringComparison.Ordinal))
            .GroupBy(card => card.Id)
            .Select(group => group.First())
            .Take(6)
            .ToList();
    }

    private void PreviewSuggestionDiff(string cardId)
    {
        var card = suggestionCards.FirstOrDefault(c => c.Id == cardId);
        if (card is null)
        {
            return;
        }

        suggestionDiffPreview = BuildSimpleDiff(editableYaml, card.ProposedYaml);
        AddAssistantMessage("assistant", $"Previewing diff for '{card.Title}'.");
    }

    private void ApplySuggestionCard(string cardId)
    {
        var card = suggestionCards.FirstOrDefault(c => c.Id == cardId);
        if (card is null)
        {
            return;
        }

        editableYaml = card.ProposedYaml;
        suggestionDiffPreview = BuildSimpleDiff(generatedYaml, editableYaml);
        deployStatusIsError = false;
        deployStatusMessage = $"Applied suggestion: {card.Title}";
        AddAssistantMessage("assistant", $"Applied '{card.Title}'. Re-run Assist YAML to validate.");
        RunYamlDiagnostics();
    }

    private static string BuildSimpleDiff(string before, string after)
    {
        var beforeLines = before.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var afterLines = after.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n');
        var max = Math.Max(beforeLines.Length, afterLines.Length);
        var diff = new List<string>();

        for (var i = 0; i < max; i++)
        {
            var oldLine = i < beforeLines.Length ? beforeLines[i] : string.Empty;
            var newLine = i < afterLines.Length ? afterLines[i] : string.Empty;
            if (string.Equals(oldLine, newLine, StringComparison.Ordinal))
            {
                continue;
            }

            if (!string.IsNullOrEmpty(oldLine))
            {
                diff.Add($"- {oldLine}");
            }

            if (!string.IsNullOrEmpty(newLine))
            {
                diff.Add($"+ {newLine}");
            }
        }

        return diff.Count == 0 ? "No differences." : string.Join("\n", diff.Take(120));
    }

    private string BuildAssistantSummary(GitLabCiLintResult lint, int cardCount)
    {
        if (!lint.Success)
        {
            return $"I could not complete GitLab lint validation: {lint.Message}";
        }

        var status = lint.Valid ? "Lint passed" : "Lint found issues";
        return $"{status}. I prepared {cardCount} suggestion card(s) for review.";
    }

    private void AddAssistantMessage(string role, string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        assistantMessages.Add(new YamlAssistantMessage(role, content.Trim(), DateTime.UtcNow));
        if (assistantMessages.Count > 24)
        {
            assistantMessages.RemoveAt(0);
        }
    }

    private void SeedAssistantWelcome()
    {
        if (assistantMessages.Count > 0)
        {
            return;
        }

        AddAssistantMessage("assistant", "I can help lint, explain issues, propose YAML patches, and show diffs before you apply changes.");
    }

    private void ClearAssistantOutput()
    {
        lintResult = null;
        assistantSuggestions.Clear();
        suggestionCards.Clear();
        suggestionDiffPreview = string.Empty;
    }

    private sealed record YamlAssistantMessage(string Role, string Content, DateTime Timestamp);

    private sealed record YamlSuggestionCard(string Id, string Category, string Title, string Description, string ProposedYaml);

    private async Task DeployYamlToRepository()
    {
        if (!CanDeployYaml)
        {
            deployStatusIsError = true;
            deployStatusMessage = "Run Test YAML and resolve blocking errors before deployment.";
            return;
        }

        deployInProgress = true;
        deployLogs.Clear();
        deployStatusMessage = string.Empty;
        deployStatusIsError = false;
        deployLogs.Add($"[{DateTime.Now:HH:mm:ss}] Starting workflow deployment...");

        var progress = new Progress<string>(message =>
        {
            deployLogs.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var selectedRepository = repositories.FirstOrDefault(r => r.Id == request.RepositoryId)
                ?? RepositoryCatalogService.AnalyzeRepository(request.RepositoryId);
            var result = await RepositoryCatalogService.DeployWorkflowToRepositoryAsync(
                request.RepositoryId,
                editableYaml,
                request.SelectedTemplate,
                request.SourceBranch,
                request.WorkflowPath,
                progress,
                CancellationToken.None);

            deployStatusIsError = !result.Success || !result.TrackingRecorded;
            deployStatusMessage = result.Message;
            deployLogs.Add($"[{DateTime.Now:HH:mm:ss}] {result.Message}");

            if (result.Success)
            {
                deployedYamlPreview = editableYaml;
                deployedWorkflowPath = result.WorkflowPath;
                deployedRepositoryName = selectedRepository.Name;
                deployedBranch = result.Branch;
                repositories = RepositoryCatalogService.GetSavedRepositorySnapshot();
                PipelineService.ReloadFromDatabase();
                Refresh();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            deployStatusIsError = true;
            deployStatusMessage = $"Deployment failed: {ex.Message}";
            deployLogs.Add($"[{DateTime.Now:HH:mm:ss}] Deployment failed: {ex.Message}");
        }
        finally
        {
            deployInProgress = false;
            StateHasChanged();
        }
    }

    private async Task ApplySuggestedTemplate(string suggestedTemplateId)
    {
        if (string.IsNullOrWhiteSpace(suggestedTemplateId) || templates.All(t => !t.Id.Equals(suggestedTemplateId, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        request.SelectedTemplate = suggestedTemplateId;
        await UpdateGeneratedPreview();
        RunYamlDiagnostics();
    }

    private void ApplyYamlSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet))
        {
            return;
        }

        if (snippet.Contains("stage: test", StringComparison.OrdinalIgnoreCase))
        {
            editableYaml = EnsureGitLabTestStage(editableYaml);
        }

        if (!editableYaml.Contains(snippet, StringComparison.Ordinal))
        {
            editableYaml = string.IsNullOrWhiteSpace(editableYaml)
                ? snippet.Trim()
                : $"{editableYaml.TrimEnd()}\n\n{snippet.Trim()}";
        }

        RunYamlDiagnostics();
    }

    private static string EnsureGitLabTestStage(string yaml)
    {
        if (string.IsNullOrWhiteSpace(yaml)
            || !yaml.Contains("stages:", StringComparison.OrdinalIgnoreCase)
            || yaml.Contains("- test", StringComparison.OrdinalIgnoreCase))
        {
            return yaml;
        }

        var normalized = yaml.Replace("\r\n", "\n", StringComparison.Ordinal);
        var newline = yaml.Contains("\r\n", StringComparison.Ordinal) ? "\r\n" : "\n";
        var lines = normalized.Split('\n').ToList();
        var stagesIndex = lines.FindIndex(line => line.Trim().Equals("stages:", StringComparison.OrdinalIgnoreCase));
        if (stagesIndex < 0)
        {
            return yaml;
        }

        var insertIndex = stagesIndex + 1;
        while (insertIndex < lines.Count && (string.IsNullOrWhiteSpace(lines[insertIndex]) || lines[insertIndex].StartsWith("  - ", StringComparison.Ordinal)))
        {
            if (lines[insertIndex].Trim().Equals("- publish", StringComparison.OrdinalIgnoreCase)
                || lines[insertIndex].Trim().Equals("- deploy", StringComparison.OrdinalIgnoreCase))
            {
                break;
            }

            insertIndex++;
        }

        lines.Insert(insertIndex, "  - test");
        return string.Join(newline, lines);
    }

    private void OnPipelineStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        PipelineService.Changed -= OnPipelineStateChanged;
    }

    private static string GetDiagnosticClass(WorkflowDiagnosticSeverity severity) => severity switch
    {
        WorkflowDiagnosticSeverity.Error => "diag-error",
        WorkflowDiagnosticSeverity.Warning => "diag-warning",
        _ => "diag-info"
    };

    private static string GetStatusClass(PipelineStatus status) => status switch
    {
        PipelineStatus.Running => "running",
        PipelineStatus.Warning => "warning",
        PipelineStatus.Failed => "warning",
        _ => string.Empty
    };
}
